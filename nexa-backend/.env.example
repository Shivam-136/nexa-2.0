# NEXA 2.0 Backend Configuration

# Server Port
PORT=5000
NODE_ENV=development

# Google Gemini API Key (KEEP EXCLUSIVELY ON BACKEND - NEVER EXPOSE TO FRONTEND)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Selection (e.g. gemini-2.5-flash, gemini-1.5-flash, gemini-2.5-pro)
GEMINI_MODEL=gemini-2.5-flash

# Frontend CORS Origin
CLIENT_ORIGIN=http://localhost:3000

# MongoDB Connection URI (Persistent Memory & Conversation Storage)
MONGODB_URI=mongodb://127.0.0.1:27017/nexa
